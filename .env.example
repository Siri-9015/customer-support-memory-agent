# ─────────────────────────────────────────────────────────────────────────────
# RecallDesk — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM ─────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq model to use (default: llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# ── Hindsight Memory ──────────────────────────────────────────────────────────
# URL of the Hindsight server (default: local Docker)
HINDSIGHT_BASE_URL=http://localhost:8888

# If using Hindsight Cloud, set your API key:
# HINDSIGHT_CLOUD_API_KEY=your_hindsight_cloud_key
HINDSIGHT_API_LLM_API_KEY=your_groq_api_key_here
# ── Backend ───────────────────────────────────────────────────────────────────
# Origins allowed to call the backend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Whether to auto-seed demo customer data on startup
SEED_DEMO_DATA=true

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Set this in frontend/.env if you deploy the backend to a different URL
# VITE_API_URL=http://localhost:8000
